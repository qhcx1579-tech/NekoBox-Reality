+// Preserve hybrid key exchange when the fingerprint supplies both extensions.
+// New REALITY servers require this share before the optional plain X25519 share.
+// Removing an incomplete pair preserves compatibility with legacy fingerprints.
+func prepareRealityKeyShares(extensions []utls.TLSExtension) {
+	var hasGroup, hasShare bool
+	for _, extension := range extensions {
+		switch ext := extension.(type) {
+		case *utls.SupportedCurvesExtension:
+			for _, group := range ext.Curves {
+				hasGroup = hasGroup || group == utls.X25519MLKEM768
+			}
+		case *utls.KeyShareExtension:
+			for _, share := range ext.KeyShares {
+				hasShare = hasShare || share.Group == utls.X25519MLKEM768
+			}
+		}
+	}
+	if hasGroup && hasShare {
+		return
+	}
+	for _, extension := range extensions {
+		switch ext := extension.(type) {
+		case *utls.SupportedCurvesExtension:
+			ext.Curves = common.Filter(ext.Curves, func(group utls.CurveID) bool {
+				return group != utls.X25519MLKEM768
+			})
+		case *utls.KeyShareExtension:
+			ext.KeyShares = common.Filter(ext.KeyShares, func(share utls.KeyShare) bool {
+				return share.Group != utls.X25519MLKEM768
+			})
+		}
+	}
+}
